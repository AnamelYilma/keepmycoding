# ==============================================================================
# KeepCoding - Environment Configuration Template (.env.example)
# Golden Rule: Zero Secret Leakage. Never commit real credentials to git!
# Copy this file to .env.local for local development.
# ==============================================================================

# AI Judge Provider Configuration (Server-side only, never expose with NEXT_PUBLIC_)
AI_API_KEY=your_key_here
AI_MODEL=gemini-2.5-flash
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional Database URL (for future user account / persistent history if configured)
DATABASE_URL=postgresql://user:password@localhost:5432/keepcoding
