# ==============================================================================
# KeepCoding - Environment Configuration Template (.env.example)
# Golden Rule: Zero Secret Leakage. Never commit real credentials to git!
# Copy this file to .env.local for local development.
# ==============================================================================

# AI Judge Provider Configuration (Google AI Studio Gemini API)
AI_API_KEY=your_gemini_api_key_here

# Supabase Auth (copy these from your Supabase project settings into .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only key for challenge solution access and recording passed attempts.
# Never use a service-role key in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Defaults to localhost for development. Set this to the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
